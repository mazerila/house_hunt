# Copy to .env (gitignored) and fill in what you need. Everything is optional
# except ANTHROPIC_API_KEY if you use the AI listing-extraction commands.

# Anthropic API key — used by scripts/listing.py for AI extraction/summaries.
ANTHROPIC_API_KEY=

# Contact email sent to open APIs (RNB `from` param, User-Agent) so maintainers
# can notify you of API changes. OPT-IN: leave empty to send no identity at all.
HOUSE_HUNT_FROM_EMAIL=

# --- Optional overrides (defaults in scripts/settings.py) -------------------
# ADEME DPE dataset id (default: meg-83tjwtg8dyz4vv7h1dqe).
#HOUSE_HUNT_ADEME_DATASET=
# Model for listing extraction (default: claude-opus-4-8).
#HOUSE_HUNT_LISTING_MODEL=
# Browser engine for portal fetches: firefox (default), chrome, chromium.
#HOUSE_HUNT_BROWSER=
# Set to 0 to run a visible browser (solve anti-bot challenges once).
#HOUSE_HUNT_HEADLESS=
# Persistent browser profile dir (default: .browser-profile/).
#HOUSE_HUNT_PROFILE_DIR=
# API response cache dir (default: .cache/).
#HOUSE_HUNT_CACHE_DIR=
